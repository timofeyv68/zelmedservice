---
import { url } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import company from '../data/company.json';
import { getCategories } from '../lib/catalog';

const categories = getCategories();
---

<BaseLayout
  title="О компании ЗелМедСервис — поставщик и сервис медицинского оборудования"
  description="Комплексный сервис сложного медицинского оборудования. Контракт неопределённого объёма, этапы централизованного обслуживания МО, 44-ФЗ и 223-ФЗ."
>
  <SearchOverlay />
  <section class="section company">
    <div class="container">
      <nav class="crumbs"><a href={url('/')}>Главная</a><span>/</span><span>О компании</span></nav>
      <span class="section__eyebrow">О компании</span>
      <h1>{company.headline}</h1>
      <p class="lead">{company.lead}</p>

      <article class="contract card">
        <div class="contract__head">
          <span class="contract__check" aria-hidden="true">✓</span>
          <div>
            <h2>{company.contractTitle}</h2>
            <p>{company.contractLead}</p>
          </div>
        </div>
        <ul class="contract__list">
          {company.servicePoints.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </article>

      <div class="stages">
        <h2>{company.serviceStepsTitle}</h2>
        <ol class="stages__list">
          {company.serviceSteps.map((s) => (
            <li class="stages__item">
              <span class="stages__n">{s.n}</span>
              <div class="stages__bar">{s.title}</div>
            </li>
          ))}
        </ol>
      </div>

      <div class="about-block">
        <h2 class="block-title">О компании</h2>
        {company.about.map((p) => <p>{p}</p>)}
      </div>

      <div class="lineup">
        <h2 class="block-title">Продуктовая линейка</h2>
        <div class="lineup__grid">
          {categories.map((c) => (
            <a class="card lineup__tile" href={url(`catalog/${c.slug}/`)}>
              <strong>{c.name}</strong>
              <span>{c.count} моделей</span>
            </a>
          ))}
        </div>
        <div class="lineup__links">
          {company.links.map((l) => (
            <a class="btn btn--soft" href={url(l.href)}>{l.label}</a>
          ))}
        </div>
      </div>

      <h2 class="block-title">Почему выбирают ЗелМедСервис</h2>
      <div class="stats">
        {company.stats.map((s) => (
          <article class="stat card">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs { display:flex; gap:.5rem; color:var(--color-muted); margin-bottom:1rem; }
  h1 { font-size: clamp(1.7rem, 3vw, 2.4rem); max-width: 18ch; }
  .lead { color: var(--color-ink-soft); max-width: 54rem; font-size: 1.08rem; line-height: 1.55; }

  .contract {
    padding: 0;
    overflow: hidden;
    margin: 1.75rem 0 1.5rem;
  }
  .contract__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 1.15rem 1.2rem;
    background: #eef3f8;
    border-bottom: 1px solid var(--color-border);
  }
  .contract__check {
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    margin-top: 0.15rem;
  }
  .contract__head h2 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
  .contract__head p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
  .contract__list {
    display: grid;
    gap: 0;
    padding: 0.35rem 0;
  }
  .contract__list li {
    position: relative;
    padding: 0.7rem 1.2rem 0.7rem 2.1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink-soft);
  }
  .contract__list li:last-child { border-bottom: 0; }
  .contract__list li::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 1.05rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-green);
  }

  .stages {
    margin: 0 0 2rem;
  }
  .stages h2 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .stages__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.65rem;
    align-items: stretch;
  }
  .stages__item {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }
  .stages__n {
    flex: 0 0 auto;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-green);
    letter-spacing: -0.03em;
  }
  .stages__bar {
    flex: 1 1 auto;
    background: var(--color-ink);
    color: #fff;
    border-radius: 999px;
    padding: 0.85rem 1rem;
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1.25;
    display: flex;
    align-items: center;
    min-height: 3.4rem;
  }

  .stats {
    display: grid; grid-template-columns: repeat(4,1fr); gap: .85rem; margin-top: 1rem;
  }
  .stat { padding: 1.1rem; display:grid; gap:.35rem; }
  .stat strong { font-size: 1.5rem; color: var(--color-accent); }
  .stat span { color: var(--color-muted); font-size: .9rem; }

  .about-block {
    margin-bottom: 2rem;
  }
  .about-block p { color: var(--color-ink-soft); max-width: 54rem; }

  .lineup { margin-bottom: 2rem; }
  .lineup__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .lineup__tile {
    padding: 1.1rem 1.15rem;
    display: grid;
    gap: 0.35rem;
    min-height: 5.5rem;
    align-content: center;
  }
  .lineup__tile strong {
    font-size: 1rem;
    line-height: 1.3;
  }
  .lineup__tile span {
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 650;
  }
  .lineup__tile:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .lineup__tile:hover span { color: var(--color-accent); }
  .lineup__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .block-title { margin: 0 0 1rem; font-size: 1.5rem; }

  @media (max-width: 1000px) {
    .stats, .lineup__grid { grid-template-columns: 1fr 1fr; }
    .stages__list { flex-wrap: wrap; }
    .stages__item { flex: 1 1 calc(50% - 0.65rem); }
  }
  @media (max-width: 640px) {
    .stats, .lineup__grid { grid-template-columns: 1fr; }
    .stages__item { flex: 1 1 100%; }
    .stages__bar { border-radius: 16px; min-height: 0; }
  }
</style>
