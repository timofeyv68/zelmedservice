---
import { url } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import company from '../data/company.json';
---

<BaseLayout
  title="О компании ЗелМедСервис — поставщик и сервис медицинского оборудования"
  description="Комплексный сервис сложного медицинского оборудования. Контракт неопределённого объёма, этапы централизованного обслуживания МО, 44-ФЗ и 223-ФЗ."
>
  <SearchOverlay />
  <section class="section company">
    <div class="container">
      <nav class="crumbs"><a href={url('/')}>Главная</a><span>/</span><span>О компании</span></nav>
      <span class="section__eyebrow">О компании</span>
      <h1>{company.headline}</h1>
      <p class="lead">{company.lead}</p>

      <div class="slide-grid">
        <article class="contract card">
          <div class="contract__head">
            <span class="contract__check" aria-hidden="true">✓</span>
            <div>
              <h2>{company.contractTitle}</h2>
              <p>{company.contractLead}</p>
            </div>
          </div>
          <ul class="contract__list">
            {company.servicePoints.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </article>

        <aside class="stages">
          <h2>{company.serviceStepsTitle}</h2>
          <ol class="stages__list">
            {company.serviceSteps.map((s) => (
              <li class="stages__item">
                <span class="stages__n">{s.n}</span>
                <div class="stages__bar">{s.title}</div>
              </li>
            ))}
          </ol>
        </aside>
      </div>

      <div class="stats">
        {company.stats.map((s) => (
          <article class="stat card">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </article>
        ))}
      </div>

      <div class="about-grid">
        <div>
          <h2 class="block-title">О компании</h2>
          {company.about.map((p) => <p>{p}</p>)}
          <div class="focus">
            {company.focus.map((f) => <span class="chip is-active">{f}</span>)}
          </div>
        </div>
        <aside class="card aside">
          <h2>Продуктовая линейка</h2>
          <ul>
            {company.productLine.map((item) => <li>{item}</li>)}
          </ul>
          <div class="aside__links">
            {company.links.map((l) => (
              <a class="btn btn--soft" href={url(l.href)}>{l.label}</a>
            ))}
          </div>
        </aside>
      </div>

      <h2 class="block-title">Почему выбирают ЗелМедСервис</h2>
      <div class="adv">
        {company.advantages.map((a) => (
          <article class="card adv__item">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs { display:flex; gap:.5rem; color:var(--color-muted); margin-bottom:1rem; }
  h1 { font-size: clamp(1.7rem, 3vw, 2.4rem); max-width: 18ch; }
  .lead { color: var(--color-ink-soft); max-width: 54rem; font-size: 1.08rem; line-height: 1.55; }

  .slide-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: 1.35rem;
    margin: 1.75rem 0 2rem;
    align-items: start;
  }

  .contract { padding: 0; overflow: hidden; }
  .contract__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 1.15rem 1.2rem;
    background: #eef3f8;
    border-bottom: 1px solid var(--color-border);
  }
  .contract__check {
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    margin-top: 0.15rem;
  }
  .contract__head h2 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
  .contract__head p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
  .contract__list {
    display: grid;
    gap: 0;
    padding: 0.35rem 0;
  }
  .contract__list li {
    position: relative;
    padding: 0.7rem 1.2rem 0.7rem 2.1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink-soft);
  }
  .contract__list li:last-child { border-bottom: 0; }
  .contract__list li::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 1.05rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-green);
  }

  .stages h2 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .stages__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .stages__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: center;
  }
  .stages__n {
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--color-green);
    letter-spacing: -0.03em;
    min-width: 2.2rem;
  }
  .stages__bar {
    background: var(--color-ink);
    color: #fff;
    border-radius: 999px;
    padding: 0.95rem 1.2rem;
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .stats {
    display: grid; grid-template-columns: repeat(4,1fr); gap: .85rem; margin: 0 0 2rem;
  }
  .stat { padding: 1.1rem; display:grid; gap:.35rem; }
  .stat strong { font-size: 1.5rem; color: var(--color-accent); }
  .stat span { color: var(--color-muted); font-size: .9rem; }
  .about-grid { display:grid; grid-template-columns: 1.3fr .9fr; gap: 1.5rem; }
  .about-grid p { color: var(--color-ink-soft); }
  .focus { display:flex; gap:.5rem; flex-wrap:wrap; margin-top:1rem; }
  .aside { padding: 1.2rem; }
  .aside h2 { font-size: 1.1rem; }
  .aside li { padding: .4rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-ink-soft); }
  .aside__links { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:1rem; }
  .block-title { margin: 0 0 1rem; font-size: 1.5rem; }
  .adv { display:grid; grid-template-columns: repeat(4,1fr); gap:.85rem; margin-top: 1rem; }
  .adv__item { padding: 1.1rem; }
  .adv__item p { color: var(--color-muted); margin:0; }

  @media (max-width: 1000px) {
    .stats, .adv, .about-grid, .slide-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .stats, .adv, .about-grid, .slide-grid { grid-template-columns: 1fr; }
    .stages__bar { border-radius: 16px; }
  }
</style>
