---
import { url } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import {
  getProducts,
  getCategories,
  getBrands,
  getDirections,
  productDisplayName,
} from '../../lib/catalog';

const products = getProducts();
const categories = getCategories();
const brands = getBrands();
const directions = getDirections();

const title = 'Каталог медицинского оборудования — купить для ЛПУ | ЗелМедСервис';
const description =
  'Каталог 2026: компьютерные томографы, МРТ, УЗИ, рентген, маммографы, эндоскопия. Поставка, монтаж и сервис. Цена по запросу.';
---

<BaseLayout title={title} description={description}>
  <SearchOverlay />
  <section class="section catalog-page">
    <div class="container">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={url('/')}>Главная</a>
        <span>/</span>
        <span>Каталог</span>
      </nav>

      <div class="catalog-page__head">
        <div>
          <span class="section__eyebrow">Каталог 2026</span>
          <h1 class="section__title">Медицинское оборудование для ЛПУ</h1>
          <p class="catalog-page__lead">
            {products.length} позиций из PDF-каталога ЗелМедСервис. Фильтры по направлению, категории и бренду —
            удобный поиск модели на выставке и для закупки.
          </p>
        </div>
        <a class="btn btn--primary" href={url('catalog-2026.pdf')} target="_blank" rel="noopener">Скачать PDF</a>
      </div>

      <form class="filters card" method="get" action={url('catalog/')} data-catalog-filters>
        <label>
          Поиск
          <input type="search" name="q" placeholder="КТ, Samsung, маммограф…" data-filter-q />
        </label>
        <label>
          Направление
          <select name="direction" data-filter-direction>
            <option value="">Все</option>
            {directions.map((d) => <option value={d.slug}>{d.name}</option>)}
          </select>
        </label>
        <label>
          Категория
          <select name="category" data-filter-category>
            <option value="">Все</option>
            {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
          </select>
        </label>
        <label>
          Бренд
          <select name="brand" data-filter-brand>
            <option value="">Все</option>
            {brands.map((b) => <option value={b.slug}>{b.name} ({b.count})</option>)}
          </select>
        </label>
        <label>
          Срезы КТ
          <select name="slices" data-filter-slices>
            <option value="">Все</option>
            <option value="16">16</option>
            <option value="32">32</option>
            <option value="64">64+</option>
            <option value="128">128</option>
            <option value="160">160+</option>
            <option value="512">512+</option>
          </select>
        </label>
        <label>
          Класс УЗИ
          <select name="usclass" data-filter-usclass>
            <option value="">Все</option>
            <option value="premium">Премиальный</option>
            <option value="expert">Экспертный</option>
            <option value="high">Высокий</option>
            <option value="compact">Компактный</option>
            <option value="portable">Портативный</option>
          </select>
        </label>
        <label>
          Тип рентгена
          <select name="xray" data-filter-xray>
            <option value="">Все</option>
            <option value="mobile">Палатный</option>
            <option value="remote">Телеуправляемый</option>
            <option value="two-station">2 раб. места</option>
            <option value="fluoro">Флюорограф</option>
            <option value="universal">Универсальный</option>
          </select>
        </label>
      </form>

      <div class="category-chips">
        {categories.map((c) => (
          <a class="chip" href={url(`catalog/${c.slug}/`)}>{c.chip || c.name} · {c.count}</a>
        ))}
      </div>

      <p class="catalog-page__count" data-result-count>{products.length} товаров</p>

      <div class="flagships__grid" data-product-grid>
        {products.map((p) => (
          <div
            data-product
            data-category={p.categorySlug}
            data-brand={p.brandSlug}
            data-direction={p.direction}
            data-slices={p.filters?.slices ?? ''}
            data-usclass={p.filters?.usClass ?? ''}
            data-xray={p.filters?.xrayType ?? ''}
            data-name={productDisplayName(p).toLowerCase()}
            data-search={`${productDisplayName(p)} ${p.name} ${p.brand} ${p.category} ${p.description} ${(p.specs || []).join(' ')}`.toLowerCase()}
          >
            <ProductCard
              name={p.name}
              brand={p.brand}
              description={p.description}
              categorySlug={p.categorySlug}
              slug={p.slug}
              image={p.image}
              specs={p.specs}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .crumbs a:hover {
    color: var(--color-accent);
  }

  .catalog-page__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .catalog-page__lead {
    color: var(--color-muted);
    max-width: 46rem;
    margin: 0.5rem 0 0;
  }

  .filters {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: 0.85rem;
    padding: 1rem;
    margin-bottom: 1rem;
  }
  .filters label:nth-child(n + 5) {
    grid-column: span 1;
  }

  .filters label {
    display: grid;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .filters input,
  .filters select {
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.55rem 0.8rem;
    background: #fff;
  }

  .category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .catalog-page__count {
    color: var(--color-muted);
    font-weight: 650;
    margin-bottom: 1rem;
  }

  .flagships__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 1100px) {
    .flagships__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .filters {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .flagships__grid,
    .filters {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const params = new URLSearchParams(location.search);
  const q = document.querySelector('[data-filter-q]') as HTMLInputElement | null;
  const direction = document.querySelector('[data-filter-direction]') as HTMLSelectElement | null;
  const category = document.querySelector('[data-filter-category]') as HTMLSelectElement | null;
  const brand = document.querySelector('[data-filter-brand]') as HTMLSelectElement | null;
  const slices = document.querySelector('[data-filter-slices]') as HTMLSelectElement | null;
  const usclass = document.querySelector('[data-filter-usclass]') as HTMLSelectElement | null;
  const xray = document.querySelector('[data-filter-xray]') as HTMLSelectElement | null;
  const countEl = document.querySelector('[data-result-count]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-product]')];

  if (q && params.get('q')) q.value = params.get('q') || '';
  if (direction && params.get('direction')) direction.value = params.get('direction') || '';
  if (category && params.get('category')) category.value = params.get('category') || '';
  if (brand && params.get('brand')) brand.value = params.get('brand') || '';
  if (slices && params.get('slices')) slices.value = params.get('slices') || '';
  if (usclass && params.get('usclass')) usclass.value = params.get('usclass') || '';
  if (xray && params.get('xray')) xray.value = params.get('xray') || '';

  const matchSlices = (raw: string, want: string) => {
    if (!want) return true;
    const n = Number(raw);
    if (!Number.isFinite(n)) return false;
    if (want === '16') return n === 16;
    if (want === '32') return n === 32;
    if (want === '64') return n >= 64 && n < 128;
    if (want === '128') return n === 128;
    if (want === '160') return n >= 160 && n < 512;
    if (want === '512') return n >= 512;
    return false;
  };

  const apply = () => {
    const qq = (q?.value || '').trim().toLowerCase();
    const d = direction?.value || '';
    const c = category?.value || '';
    const b = brand?.value || '';
    const s = slices?.value || '';
    const u = usclass?.value || '';
    const x = xray?.value || '';
    let visible = 0;
    items.forEach((el) => {
      const ok =
        (!qq || (el.dataset.search || '').includes(qq)) &&
        (!d || el.dataset.direction === d) &&
        (!c || el.dataset.category === c) &&
        (!b || el.dataset.brand === b) &&
        matchSlices(el.dataset.slices || '', s) &&
        (!u || el.dataset.usclass === u) &&
        (!x || el.dataset.xray === x);
      el.hidden = !ok;
      if (ok) visible += 1;
    });
    if (countEl) countEl.textContent = `${visible} товаров`;
    const next = new URLSearchParams();
    if (qq) next.set('q', qq);
    if (d) next.set('direction', d);
    if (c) next.set('category', c);
    if (b) next.set('brand', b);
    if (s) next.set('slices', s);
    if (u) next.set('usclass', u);
    if (x) next.set('xray', x);
    history.replaceState(null, '', `${location.pathname}${next.toString() ? `?${next}` : ''}`);
  };

  [q, direction, category, brand, slices, usclass, xray].forEach((el) => el?.addEventListener('input', apply));
  [direction, category, brand, slices, usclass, xray].forEach((el) => el?.addEventListener('change', apply));
  apply();
</script>
