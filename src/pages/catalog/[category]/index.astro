---
import { url } from '../../../lib/paths';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import SearchOverlay from '../../../components/SearchOverlay.astro';
import { getCategories, getProductsByCategory, getBrands } from '../../../lib/catalog';

export function getStaticPaths() {
  return getCategories().map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const products = getProductsByCategory(category.slug);
const brands = getBrands().filter((b) => products.some((p) => p.brandSlug === b.slug));
---

<BaseLayout title={category.seoTitle} description={category.seoDescription}>
  <SearchOverlay />
  <section class="section">
    <div class="container">
      <nav class="crumbs">
        <a href={url('/')}>Главная</a><span>/</span>
        <a href={url('catalog/')}>Каталог</a><span>/</span>
        <span>{category.name}</span>
      </nav>
      <h1>{category.name}</h1>
      <p class="lead">
        Купить {category.name.toLowerCase()} для медицинских учреждений. В разделе {products.length} моделей
        из каталога 2026. Цена по запросу, поставка и сервис по России.
      </p>

      {brands.length > 0 && (
        <div class="chips">
          {brands.map((b) => (
            <a class="chip" href={url(`brands/${b.slug}/`)}>{b.name}</a>
          ))}
        </div>
      )}

      <div class="grid">
        {products.map((p) => (
          <ProductCard
            name={p.name}
            brand={p.brand}
            description={p.description}
            categorySlug={p.categorySlug}
            slug={p.slug}
            image={p.image}
            specs={p.specs}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  h1 { margin-bottom: 0.5rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .lead { color: var(--color-muted); max-width: 48rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0 1.5rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
