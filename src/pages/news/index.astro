---
import { url } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import news from '../../data/news.json';

const items = [...news].sort((a, b) => {
  const da = a.date?.split('.').reverse().join('') || '';
  const db = b.date?.split('.').reverse().join('') || '';
  return db.localeCompare(da);
});
---

<BaseLayout
  title="Новости ЗелМедСервис — выставки и события"
  description="Новости компании ЗелМедСервис: участие в выставках, саммитах и отраслевых мероприятиях."
>
  <SearchOverlay />
  <section class="section">
    <div class="container">
      <nav class="crumbs"><a href={url('/')}>Главная</a><span>/</span><span>Новости</span></nav>
      <h1>Новости</h1>
      <ul class="list">
        {items.map((n) => (
          <li>
            <a href={url(`news/${n.slug}/`)}>
              <time>{n.date || '—'}</time>
              <span class="title">{n.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs { display:flex; gap:.5rem; color:var(--color-muted); margin-bottom:1rem; }
  .list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }
  .list li {
    border-bottom: 1px solid var(--color-border);
  }
  .list a {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.95rem 0;
    color: var(--color-ink);
  }
  .list a:hover .title {
    color: var(--color-accent);
  }
  time {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .title {
    font-weight: 750;
    font-size: 1.08rem;
    line-height: 1.35;
  }
  @media (max-width: 560px) {
    .list a {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
