---
import { url } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import news from '../../data/news.json';

const items = [...news].sort((a, b) => {
  const da = a.date?.split('.').reverse().join('') || '';
  const db = b.date?.split('.').reverse().join('') || '';
  return db.localeCompare(da);
});
---

<BaseLayout
  title="Новости ЗелМедСервис — выставки и события"
  description="Новости компании ЗелМедСервис: участие в выставках, саммитах и отраслевых мероприятиях."
>
  <SearchOverlay />
  <section class="section">
    <div class="container">
      <nav class="crumbs"><a href={url('/')}>Главная</a><span>/</span><span>Новости</span></nav>
      <h1>Новости</h1>
      <p class="lead">События, выставки и отраслевые мероприятия. Материалы без иллюстраций — текст и даты.</p>
      <div class="list">
        {items.map((n) => (
          <a class="card item" href={url(`news/${n.slug}/`)}>
            <time>{n.date || '—'}</time>
            <h2>{n.title}</h2>
            <p>{n.body.slice(0, 180)}…</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs { display:flex; gap:.5rem; color:var(--color-muted); margin-bottom:1rem; }
  .lead { color:var(--color-muted); max-width:40rem; }
  .list { display:grid; gap:.85rem; margin-top:1.5rem; }
  .item { padding: 1.15rem 1.25rem; display:grid; gap:.4rem; }
  .item:hover { border-color: var(--color-accent); }
  time { color: var(--color-accent); font-weight: 800; font-size: .85rem; }
  h2 { margin:0; font-size: 1.15rem; }
  p { margin:0; color: var(--color-muted); }
</style>
