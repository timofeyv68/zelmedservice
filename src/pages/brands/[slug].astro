---
import { url } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import { getBrands, getProductsByBrand } from '../../lib/catalog';

export function getStaticPaths() {
  return getBrands().map((b) => ({ params: { slug: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props;
const products = getProductsByBrand(brand.slug);
const categories = [...new Set(products.map((p) => p.category))];
---

<BaseLayout title={brand.seoTitle} description={brand.seoDescription}>
  <SearchOverlay />
  <section class="section">
    <div class="container">
      <nav class="crumbs">
        <a href={url('/')}>Главная</a><span>/</span>
        <a href={url('brands/')}>Бренды</a><span>/</span>
        <span>{brand.name}</span>
      </nav>
      <h1>Медицинское оборудование {brand.name}</h1>
      <p class="lead">
        Подборка {products.length} моделей {brand.name} из каталога ЗелМедСервис 2026.
        Поставка для ЛПУ, монтаж и сервис. Цена по запросу.
      </p>
      <p class="cats">Категории: {categories.join(', ')}</p>
      <div class="grid">
        {products.map((p) => (
          <ProductCard
            name={p.name}
            brand={p.brand}
            description={p.description}
            categorySlug={p.categorySlug}
            slug={p.slug}
            image={p.image}
            specs={p.specs}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs { display:flex; gap:.5rem; color:var(--color-muted); margin-bottom:1rem; flex-wrap:wrap; }
  .lead { color:var(--color-muted); max-width:46rem; }
  .cats { font-weight:650; color:var(--color-ink-soft); }
  .grid {
    display:grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap:1rem; margin-top:1.25rem;
  }
  @media (max-width: 1100px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
