---
import { productPath, standPath } from '../lib/catalog';
import { url } from '../lib/paths';

interface Props {
  name: string;
  brand: string;
  description: string;
  categorySlug: string;
  slug: string;
  image?: string | null;
  specs?: string[];
}

const { name, brand, description, categorySlug, slug, image, specs = [] } = Astro.props;
const href = productPath({ categorySlug, slug });
const brochure = standPath({ slug });
const imageSrc = image ? url(String(image).replace(/^\//, '')) : '';
---

<article class="product-card card">
  <a class="product-card__media" href={href}>
    {imageSrc ? (
      <img src={imageSrc} alt={name} loading="lazy" width="640" height="400" />
    ) : (
      <div class="product-card__placeholder" aria-hidden="true">
        <span>{brand}</span>
      </div>
    )}
  </a>
  <div class="product-card__body">
    <div class="product-card__meta">
      <span class="product-card__brand">{brand}</span>
      <a class="product-card__qr" href={`${href}#share`} title="QR и ссылка">QR</a>
    </div>
    <h3 class="product-card__title"><a href={href}>{name}</a></h3>
    <p class="product-card__desc">{description}</p>
    {specs.length > 0 && (
      <ul class="product-card__specs">
        {specs.slice(0, 3).map((s) => <li>{s}</li>)}
      </ul>
    )}
    <div class="product-card__footer">
      <span class="product-card__price">Цена по запросу</span>
      <div class="product-card__actions">
        <a class="btn btn--ghost btn--sm" href={brochure}>Брошюра для стенда</a>
        <a class="btn btn--soft btn--sm" href={`${url('contacts/')}#request`}>Запросить КП</a>
      </div>
    </div>
  </div>
</article>

<style>
  .product-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .product-card__media {
    aspect-ratio: 16 / 11;
    background: linear-gradient(180deg, #eef4fb, #fff);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 30%, rgba(124, 193, 31, 0.18), transparent 45%),
      radial-gradient(circle at 70% 70%, rgba(31, 95, 191, 0.16), transparent 50%),
      #f3f7fc;
    color: var(--color-ink-soft);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .product-card__body {
    padding: 1rem 1.1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .product-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .product-card__brand {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .product-card__qr {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px dashed var(--color-border);
    background: var(--color-chip);
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 800;
    display: grid;
    place-items: center;
  }

  .product-card__title {
    font-size: 1.02rem;
    margin: 0;
  }

  .product-card__desc {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .product-card__specs li {
    font-size: 0.78rem;
    font-weight: 650;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }

  .product-card__footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 0.4rem;
  }

  .product-card__price {
    font-weight: 700;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }

  .product-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.btn--sm) {
    min-height: 38px;
    padding: 0.45rem 0.8rem;
    font-size: 0.82rem;
  }
</style>
