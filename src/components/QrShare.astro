---
import { qrSvg, absoluteUrl } from '../lib/qr';

interface Props {
  path: string;
  label?: string;
  size?: number;
  compact?: boolean;
}

const { path, label = 'Поделиться страницей', size = 160, compact = false } = Astro.props;
const url = absoluteUrl(path, Astro.site?.toString() || 'https://zelmedservice.ru');
const svg = await qrSvg(url, size);
---

<div class:list={['qr', compact && 'qr--compact']} data-qr-share data-url={url}>
  {!compact && <p class="qr__label">{label}</p>}
  <div class="qr__frame" set:html={svg} aria-hidden="true"></div>
  <p class="qr__url">{url.replace('https://', '')}</p>
  <div class="qr__actions">
    <button class="btn btn--soft" type="button" data-qr-copy>Копировать ссылку</button>
    <button class="btn btn--ghost" type="button" data-qr-share-btn>Поделиться</button>
    <button class="btn btn--ghost" type="button" data-qr-download>Скачать QR</button>
  </div>
  <span class="qr__toast" data-qr-toast hidden>Ссылка скопирована</span>
</div>

<style>
  .qr {
    position: relative;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .qr--compact {
    justify-items: center;
    text-align: center;
  }

  .qr__label {
    margin: 0;
    font-weight: 800;
  }

  .qr__frame {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 0.65rem;
    box-shadow: var(--shadow-sm);
  }

  .qr__frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .qr__url {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-muted);
    word-break: break-all;
  }

  .qr__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .qr__toast {
    position: absolute;
    bottom: -0.25rem;
    left: 0;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
  }
</style>

<script>
  function svgToPng(svgEl: SVGElement, filename: string) {
    const xml = new XMLSerializer().serializeToString(svgEl);
    const blob = new Blob([xml], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 512;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, 512, 512);
      ctx.drawImage(img, 0, 0, 512, 512);
      canvas.toBlob((png) => {
        if (!png) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(png);
        a.download = filename;
        a.click();
        URL.revokeObjectURL(a.href);
        URL.revokeObjectURL(url);
      });
    };
    img.src = url;
  }

  document.querySelectorAll<HTMLElement>('[data-qr-share]').forEach((root) => {
    const url = root.dataset.url || location.href;
    const toast = root.querySelector<HTMLElement>('[data-qr-toast]');
    const showToast = () => {
      if (!toast) return;
      toast.hidden = false;
      setTimeout(() => { toast.hidden = true; }, 1600);
    };

    root.querySelector('[data-qr-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        showToast();
      } catch {
        prompt('Скопируйте ссылку:', url);
      }
    });

    root.querySelector('[data-qr-share-btn]')?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
          return;
        } catch {}
      }
      try {
        await navigator.clipboard.writeText(url);
        showToast();
      } catch {
        prompt('Скопируйте ссылку:', url);
      }
    });

    root.querySelector('[data-qr-download]')?.addEventListener('click', () => {
      const svg = root.querySelector('svg');
      if (svg) svgToPng(svg, 'zelmedservice-qr.png');
    });
  });
</script>
