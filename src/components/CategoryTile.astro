---
interface Props {
  name: string;
  description: string;
  count: number;
  href?: string;
  shortName?: string;
}

const { name, description, count, href = '/catalog/', shortName } = Astro.props;
---

<a class="tile card" href={href}>
  <div class="tile__top">
    <span class="tile__badge">{shortName || name}</span>
    <span class="tile__count">{count} мод.</span>
  </div>
  <h3>{name}</h3>
  <p>{description}</p>
  <span class="tile__more">Смотреть каталог →</span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.25rem;
    min-width: 260px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tile:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }

  .tile__top {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tile__badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--color-chip);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .tile__count {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 650;
  }

  .tile h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .tile p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    flex: 1;
  }

  .tile__more {
    font-weight: 750;
    color: var(--color-accent);
    font-size: 0.9rem;
  }
</style>
